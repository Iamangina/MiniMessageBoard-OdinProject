<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Index</title>
</head>
<body>
    <% for(const message of messages){ %>
            <h1>Author: <%= message.user %></h1>
            <h2><%= message.text %></h2>
            <h3><%= message.added %></h3>
            <a href="/message/<%= messages.indexOf(message) %>">
                <button>Open</button>
            </a>
    <% } %>
    <button><a href="/new">New Form</a></button>    
</body>
</html>